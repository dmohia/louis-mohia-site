---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getRelativeLocaleUrl } from '../../i18n';

const t = useTranslations('en');
---

<BaseLayout>
  <section class="hero">
    <h1>{t('home.title')}</h1>
    <p class="hero-subtitle">{t('home.subtitle')}</p>
    <a href={getRelativeLocaleUrl('en', 'contact')} class="btn btn-primary">{t('home.cta')}</a>
  </section>

  <section class="section">
    <h2 class="section-title">{t('nav.services')}</h2>
    <div class="card-grid">
      <div class="card">
        <h3 class="card-title">Strategic consulting</h3>
        <p class="card-description">Guidance in defining your digital strategy and identifying growth opportunities.</p>
      </div>
      <div class="card">
        <h3 class="card-title">Web development</h3>
        <p class="card-description">Creating high-performance, custom websites, from landing pages to complex web applications.</p>
      </div>
      <div class="card">
        <h3 class="card-title">Automation</h3>
        <p class="card-description">Optimizing your business processes through automation and no-code/low-code tools.</p>
      </div>
    </div>
  </section>
</BaseLayout>
